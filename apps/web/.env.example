# Copy to .env in this directory. Replace the placeholder locally.
# Percent-encode special characters in URL passwords. Never use NEXT_PUBLIC_ here.
DATABASE_URL="mysql://resolve_dev:REPLACE_WITH_PASSWORD@127.0.0.1:3306/resolve_dev"
# Separate, disposable database used by Prisma migrate dev. Never use the main DB here.
SHADOW_DATABASE_URL="mysql://resolve_dev:REPLACE_WITH_PASSWORD@127.0.0.1:3306/resolve_shadow"

# Generate a random secret of at least 32 characters; use HTTPS in production.
BETTER_AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET"
BETTER_AUTH_URL="http://127.0.0.1:3000"
# Local demo account provisioning only (12-128 characters). Never a production password.
DEV_SEED_PASSWORD="REPLACE_WITH_A_LOCAL_DEMO_PASSWORD"

# Local background worker; start Redis with compose.redis.yaml from the repo root.
REDIS_URL="redis://127.0.0.1:6379/0"
BULLMQ_PREFIX="resolve-local"
